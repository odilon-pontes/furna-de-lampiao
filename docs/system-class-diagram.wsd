@startuml SystemClassDiagram

class Pessoa {
    - nome: String
    - cpf: String
    - dataNasc: LocalDate
    - email: String
    - telefone: String
    - situacaoAtiva: boolean
    - endereco: Endereco
}

class Endereco {
    - logradouro: String
    - numero: int
    - complemento: String
    - bairro: String
    - cidade: String
    - uf: Enum
    - cep: String
}

class Pesquisador {
    - numRegistroInstitucional: int
    - areaPrincipalPesquisa: String
    - titulacao: Enum
    - valorDiarioBolsa: float

}

class GuiaEspeleologico {
    - numCredenciamento: int
    - nivelCetificacao: Enum
    - dataValidadeCertificacao: LocalDate
    - qtdExpedicoesConcluidas: int
}

class Participacao {
    - papel: String
    - dataConfirmacao: LocalDate
    - valorDiaria: float
    - qtdPrevistaDias: int
    - PresencaConfirmada: boolean
    - observacoes: String
}

class Caverna {
    - nomeOficial: String
    - codCadastroAmbiental: String
    - municipio: String
    - uf: Enum
    - coordenadas: Localizacao
    - altitude: String
    - extensao: String
    - dataUltimaInspecao: LocalDate
    - indicacaoAcessAtualmentePermitido: String
    'implicito?
    - setor: Setor 
}

class Localizacao {
    - latitude: String
    - longitude: String
    - datumGeodesico: String
}

class Setor {
    - denominacao: String
    - nivelEstimadoDificuldade: Enum
    - profundidadeMaxima: float
    - extensaoAproximada: String
    - descricao: String
    - riscoInundacao: float
    - condicaoCorrente: Enum
}

class Expedicao {
    - id: String
    - titulo: String
    - objetivo: String
    - dataHoraInicio: TimeStamp
    - dataHoraTermino: TimeStamp
    - orcamentoAprovado: boolean
    - custoRealizado: float
    - qtdMaxParticipantes: int
    - situacao: Enum
    - indicacaoCancelamentoEmergencial: String
    'implicito?
    - caverna: Caverna
    - planoSeguranca: PlanoSeguranca
    - autorizacaoAmbiental: AutorizacaoAmbiental
}

class PlanoSeguranca {
    - ProcedimentosEvacuacao: List<String>
    - pontoExternoEncontro: Localizacao
    - tempoMaxSemComunicacao: int
    - telefoneEmergencia: String
    - NecessidadeEquipeMedica: String
    - mapaRota: byte[]
}

class AutorizacaoAmbiental {
    - num: int
    - orgaoEmissor: String
    - datasEmissao: List<LocalDate>
    - validade: LocalDate
    - situacao: Enum
    - observacoes: String
    - ArquivoPDFAssinado: byte[]
}

class Equipamento {
    - codPatrimonial: String
    - nome: String
    - tipo: Enum
    - fabricante: String
    - valorAquisicao: float
    - dataCompra: LocalDate
    - dataUltimaManutencao: LocalDate
    - situacaoOperacional: Enum
    - IndicacaoCalibracao: float
}

class Movimentacao {
    - responsavelRetirada: Pessoa
    - datahoraRetirada: LocalDateTime
    - previsao: LocalDate
    - dataDevolucao: LocalDate 
    - estadoSaida: Enum
    - estadoRetorno: Enum
    - custoAvaria: float
}

class ColetaCientifica {
    - setor: Setor
    - pesquisadorResponsavel: Pesquisador
    - dataHora: LocalDateTime
    - metodoEmpregado: Enum
    - descricaoPonto: String
    - temperatura: float
    - umidadeRelativa: float
    - profundidade: float
    - observacoes: String
    - situacaoValidacao: Enum
}

class Amostra {
    - id: int
    - categoria: Enum
    - volume: float
    - unidadeMedida: Enum
    - dataAcondicionamento: LocalDate
    - condicaoConservacao: Enum
    - indicacaoMaterialPerigoso: float
    - fotografia: byte[]
    - observacoes: String
}

class Relatorio {
    - titulo: String
    - resumo: String
    - dataSubmissao: LocalDate
    - numPaginas: int
    - situacaoAprovacao: Enum
    - arquivoCompleto: byte[]
    - indicacaoPublicacaoAutorizada: String
}

Pessoa <|-- Pesquisador
Pessoa <|-- GuiaEspeleologico
Pessoa -- Endereco

Pessoa "1" -- "0..*" Participacao
Expedicao "1" -- "0..*" Participacao
Caverna "1" -- "1..*" Setor
Caverna "1" -- "0..*" Expedicao
Setor "0..*" -- "0..*" Expedicao
Expedicao "1" -- "1" AutorizacaoAmbiental
Pessoa "1" -- "0..*" Movimentacao
Movimentacao "0..*" -- "1" Equipamento
Movimentacao "0..*" -- "1" Expedicao
Expedicao "1" -- "0..*" ColetaCientifica
ColetaCientifica "1" -- "1..*" Amostra
Expedicao -- Relatorio
Caverna "1..*" -- "1" Localizacao
Expedicao "1..*" -- "1" PlanoSeguranca

@enduml