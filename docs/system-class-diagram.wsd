@startuml SystemClassDiagram

class Pessoa {
    - id: Long
    - nome: String
    - cpf: String
    - dataNasc: LocalDate
    - email: String
    - telefone: String
    - situacaoAtiva: Boolean
    - endereco: Endereco
}

class Endereco <<Embeddable>> {
    - logradouro: String
    - numero: String
    - complemento: String
    - bairro: String
    - cidade: String
    - uf: UnidadeFederativa
    - cep: String
}

class Pesquisador {
    - numRegistroInstitucional: String
    - areaPrincipalPesquisa: String
    - titulacao: Titulacao
    - valorDiarioBolsa: BigDecimal
}

class GuiaEspeleologico {
    - numCredenciamento: String
    - nivelCertificacao: NivelCertificacao
    - dataValidadeCertificacao: LocalDate
    - qtdExpedicoesConcluidas: Integer
}

class Participacao {
    - id: Long
    - papelParticipante: PapelParticipante
    - dataConfirmacao: LocalDate
    - valorDiaria: BigDecimal
    - qtdPrevistaDias: Integer
    - presencaConfirmada: Boolean
    - observacoes: String
}

class Caverna {
    - id: Long
    - nomeOficial: String
    - codCadastroAmbiental: String
    - municipio: String
    - uf: UnidadeFederativa
    - coordenadas: Localizacao
    - altitude: BigDecimal
    - extensao: BigDecimal
    - dataUltimaInspecao: LocalDate
    - acessoAtualmentePermitido: Boolean
}

class Localizacao <<Embeddable>> {
    - latitude: BigDecimal
    - longitude: BigDecimal
    - datumGeodesico: String
}

class Setor {
    - id: Long
    - denominacao: String
    - nivelEstimadoDificuldade: NivelDificuldadeSetor
    - profundidadeMaxima: BigDecimal
    - extensaoAproximada: BigDecimal
    - descricao: String
    - riscoInundacao: BigDecimal
    - condicaoCorrente: CondicaoSetor
}

class Expedicao {
    - id: Long
    - codigo: String
    - titulo: String
    - objetivo: String
    - inicioPrevisto: LocalDateTime
    - terminoPrevisto: LocalDateTime
    - orcamentoAprovado: BigDecimal
    - custoRealizado: BigDecimal
    - qtdMaxParticipantes: Integer
    - situacao: SituacaoExpedicao
    - cancelamentoEmergencial: Boolean
}

class PlanoSeguranca {
    - id: Long
    - procedimentosEvacuacao: List<String>
    - pontoExternoEncontro: Localizacao
    - tempoMaxSemComunicacao: Integer
    - telefoneEmergencia: String
    - necessidadeEquipeMedica: Boolean
    - mapaRota: byte[]
}

class AutorizacaoAmbiental {
    - id: Long
    - num: Integer
    - orgaoEmissor: String
    - dataEmissao: LocalDate
    - validade: LocalDate
    - situacao: SituacaoAutorizacao
    - observacoes: String
    - arquivoPdfAssinado: byte[]
}

class Equipamento {
    - id: Long
    - codPatrimonial: String
    - nome: String
    - tipo: TipoEquipamento
    - fabricante: String
    - valorAquisicao: BigDecimal
    - dataCompra: LocalDate
    - dataUltimaManutencao: LocalDate
    - situacaoOperacional: SituacaoOperacional
    - indicacaoCalibracao: Boolean
}

class Movimentacao {
    - id: Long
    - dataHoraRetirada: LocalDateTime
    - dataPrevisaoDevolucao: LocalDate
    - dataDevolucao: LocalDate
    - estadoSaida: EstadoSaida
    - estadoRetorno: EstadoRetorno
    - custoAvaria: BigDecimal
}

class ColetaCientifica {
    - id: Long
    - dataHoraColeta: LocalDateTime
    - metodoEmpregado: MetodoEmpregado
    - descricaoPonto: String
    - temperatura: BigDecimal
    - umidadeRelativa: BigDecimal
    - profundidade: BigDecimal
    - observacoes: String
    - situacaoValidacao: SituacaoValidacaoColeta
}

class Amostra {
    - id: Long
    - codCampo: String
    - categoriaAmostra: CategoriaAmostra
    - volume: BigDecimal
    - unidadeMedida: UnidadeMedida
    - dataAcondicionamento: LocalDateTime
    - condicaoAmostra: CondicaoConservacaoAmostra
    - indicacaoMaterialPerigoso: Boolean
    - fotografia: byte[]
    - observacoes: String
}

class Relatorio {
    - id: Long
    - titulo: String
    - resumo: String
    - dataSubmissao: LocalDateTime
    - numeroTotalPaginas: Integer
    - situacaoRelatorioFinal: SituacaoRelatorioFinal
    - arquivoCompleto: byte[]
    - publicacaoAutorizada: Boolean
}

enum SituacaoExpedicao {
    PLANEJADA
    AUTORIZADA
    EM_ANDAMENTO
    CONCLUIDA
    CANCELADA
}

enum NivelDificuldadeSetor {
    BAIXO
    MODERADO
    ALTO
    EXTREMO
}

enum CondicaoSetor {
    DISPONIVEL
    INTERDITADO
    EM_MONITORAMENTO
    INACESSIVEL
}

enum PapelParticipante {
    PESQUISADOR
    GUIA_ESPELEOLOGICO
    COORDENADOR
    FOTOGRAFO
    TECNICO
    AUXILIAR
}

enum SituacaoAutorizacao {
    PENDENTE
    VIGENTE
    EXPIRADA
    NEGADA
}

enum SituacaoOperacional {
    DISPONIVEL
    EM_USO
    EM_MANUTENCAO
    DANIFICADO
    INDISPONIVEL
}

enum TipoEquipamento {
    CAMERA
    GPS
    LANTERNA
    CAPACETE
    CORDA
    DETECTOR_DE_GASES
    OUTRO
}

enum EstadoSaida {
    PENDENTE
    REALIZADA
    CANCELADA
}

enum EstadoRetorno {
    PENDENTE
    DEVOLVIDO
    ATRASADO
    DANIFICADO
}

enum MetodoEmpregado {
    COLETA_MANUAL
    ARMADILHA
    REDE_DE_NEVOA
    CAPTURA_DIRETA
    AMOSTRAGEM_DE_SOLO
    AMOSTRAGEM_DE_AGUA
    ARMADILHA_FOTOGRAFICA
    OBSERVACAO_DIRETA
    OUTRO
}

enum SituacaoValidacaoColeta {
    PENDENTE
    VALIDADA
    REJEITADA
}

enum CategoriaAmostra {
    MINERAL
    BIOLOGICA
    GEOLOGICA
    ARQUEOLOGICA
    PALEONTOLOGICA
    OUTRA
}

enum UnidadeMedida {
    UNIDADE
    QUILOGRAMA
    GRAMA
    LITRO
    MILILITRO
    METRO
    CENTIMETRO
    METRO_QUADRADO
    METRO_CUBICO
}

enum CondicaoConservacaoAmostra {
    EXCELENTE
    BOA
    REGULAR
    RUIM
    DANIFICADA
}

enum SituacaoRelatorioFinal {
    EM_ELABORACAO
    SUBMETIDO
    EM_ANALISE
    APROVADO
    REJEITADO
}

enum Titulacao {
    GRADUACAO
    ESPECIALIZACAO
    MESTRADO
    DOUTORADO
    POS_DOUTORADO
}

enum NivelCertificacao {
    NIVEL_I
    NIVEL_II
    NIVEL_III
}

enum UnidadeFederativa {
    AC
    AL
    AP
    AM
    BA
    CE
    DF
    ES
    GO
    MA
    MT
    MS
    MG
    PA
    PB
    PR
    PE
    PI
    RJ
    RN
    RS
    RO
    RR
    SC
    SP
    SE
    TO
}

Pessoa <|-- Pesquisador
Pessoa <|-- GuiaEspeleologico
Pessoa "1" *-- "1" Endereco

Pessoa "1" --> "0..*" Participacao
Expedicao "1" --> "0..*" Participacao
Caverna "1" *-- "0..*" Setor
Caverna "1" --> "0..*" Expedicao
Expedicao "0..*" --> "0..*" Setor : visita >
Expedicao "1" *-- "1" PlanoSeguranca
Expedicao "1" --> "0..*" AutorizacaoAmbiental : histórico >
Pessoa "1" --> "0..*" Movimentacao : responsável retirada >
Equipamento "1" --> "0..*" Movimentacao
Expedicao "1" --> "0..*" Movimentacao
Expedicao "1" --> "0..*" ColetaCientifica
Setor "1" --> "0..*" ColetaCientifica
Pesquisador "1" --> "0..*" ColetaCientifica : responsável >
ColetaCientifica "1" --> "0..*" Amostra
Expedicao "1" --> "0..1" Relatorio
Caverna "1" *-- "1" Localizacao
PlanoSeguranca "1" *-- "1" Localizacao

Endereco --> UnidadeFederativa
Caverna --> UnidadeFederativa
Setor --> NivelDificuldadeSetor
Setor --> CondicaoSetor
Expedicao --> SituacaoExpedicao
AutorizacaoAmbiental --> SituacaoAutorizacao
Participacao --> PapelParticipante
Equipamento --> TipoEquipamento
Equipamento --> SituacaoOperacional
Movimentacao --> EstadoSaida
Movimentacao --> EstadoRetorno
ColetaCientifica --> MetodoEmpregado
ColetaCientifica --> SituacaoValidacaoColeta
Amostra --> CategoriaAmostra
Amostra --> UnidadeMedida
Amostra --> CondicaoConservacaoAmostra
Relatorio --> SituacaoRelatorioFinal
Pesquisador --> Titulacao
GuiaEspeleologico --> NivelCertificacao

@enduml