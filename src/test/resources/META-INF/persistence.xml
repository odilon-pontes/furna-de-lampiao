<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.2"
             xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="
                http://xmlns.jcp.org/xml/ns/persistence
                http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd">

    <persistence-unit name="furnaTestPU" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <mapping-file>META-INF/orm.xml</mapping-file>

        <class>com.furnadelampiao.domain.Pessoa</class>
        <class>com.furnadelampiao.domain.Pesquisador</class>
        <class>com.furnadelampiao.domain.GuiaEspeleologico</class>
        <class>com.furnadelampiao.domain.Caverna</class>
        <class>com.furnadelampiao.domain.Expedicao</class>
        <class>com.furnadelampiao.domain.Setor</class>
        <class>com.furnadelampiao.domain.Equipamento</class>
        <class>com.furnadelampiao.domain.PlanoSeguranca</class>
        <class>com.furnadelampiao.domain.AutorizacaoAmbiental</class>
        <class>com.furnadelampiao.domain.Relatorio</class>
        <class>com.furnadelampiao.domain.Participacao</class>
        <class>com.furnadelampiao.domain.ColetaCientifica</class>
        <class>com.furnadelampiao.domain.Movimentacao</class>
        <class>com.furnadelampiao.domain.Amostra</class>

        <properties>

            <property
                    name="javax.persistence.jdbc.driver"
                    value="org.postgresql.Driver"/>

            <property
                    name="javax.persistence.jdbc.url"
                    value="jdbc:postgresql://localhost:5432/furna_test_db"/>

            <property
                    name="javax.persistence.jdbc.user"
                    value="postgres"/>

            <property
                    name="javax.persistence.jdbc.password"
                    value="postgrespassword"/>

            <property
                    name="hibernate.dialect"
                    value="org.hibernate.dialect.PostgreSQL10Dialect"/>

            <property
                    name="hibernate.hbm2ddl.auto"
                    value="create-drop"/>

            <property
                    name="hibernate.show_sql"
                    value="true"/>

            <property
                    name="hibernate.format_sql"
                    value="true"/>

        </properties>

    </persistence-unit>

</persistence>